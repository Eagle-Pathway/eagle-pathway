{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "5.0",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@screens/*": ["./src/screens/*"],
      "@services/*": ["./src/services/*"],
      "@store/*": ["./src/store/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@utils/*": ["./src/utils/*"],
      "@types/*": ["./src/types/*"],
      "@eagle-pathway/shared": ["../packages/eagle-shared/src/index"],
      "@eagle-pathway/shared/*": ["../packages/eagle-shared/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "supabase/functions"]
}

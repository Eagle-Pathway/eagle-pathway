{
  "expo": {
    "name": "Eagle Pathway",
    "slug": "eagle-pathway",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E4D9B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eaglepathway.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E4D9B"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.eaglepathway.app",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#1E4D9B"
        }
      ]
    ],
    "scheme": "eaglepathway",
    "extra": {
      "supabaseUrl": "YOUR_SUPABASE_URL",
      "supabaseAnonKey": "YOUR_SUPABASE_ANON_KEY",
      "router": {},
      "eas": {
        "projectId": "e9e50db8-99a2-4004-9e3a-63661f1a847a"
      }
    },
    "owner": "tise_genene",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e9e50db8-99a2-4004-9e3a-63661f1a847a"
    }
  }
}

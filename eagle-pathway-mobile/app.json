{
  "expo": {
    "name": "Eagle Pathway",
    "slug": "eagle-pathway",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/expo-icon-1024.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b2a5b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eaglepathway.app"
    },
    "android": {
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground-1024.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome-1024.png",
        "backgroundColor": "#0b2a5b"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.eaglepathway.app",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#0b2a5b"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableEdgeToEdge": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keepattributes *Annotation*"
          }
        }
      ],
      "./plugins/with-cmake-args",
      "expo-web-browser"
    ],
    "scheme": "eaglepathway",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e78c6e36-63e3-4e25-b7df-6323b8b28809"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e78c6e36-63e3-4e25-b7df-6323b8b28809",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 1000
    }
  }
}

# ─── Supabase (Public — safe to expose to the browser) ───────────────────────
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Supabase (Server-only — NEVER expose to the browser) ────────────────────
# Used only in Next.js Server Actions / API Routes to bypass RLS
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Server-only key — used by /api/sop-review and /api/assistant routes
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here